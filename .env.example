# Copy to .env and fill in. Vite reads these at build time, so set the same
# variables in your hosting provider's build settings and rebuild after changes.

# Web3Forms access key - create one at https://web3forms.com for the inbox that
# should receive contact-form messages. It is sent from the browser, so it is
# public by design; restrict it to your domain in the Web3Forms dashboard.
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: subject line and sender name on the notification email.
VITE_CONTACT_SUBJECT="New Contact Form Submission"
VITE_CONTACT_FROM_NAME="Deepu Kunjumon | Personal Portfolio"
